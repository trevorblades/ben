---
import { ArrowRightIcon } from "@phosphor-icons/react";
import Link from "astro-typesafe-routes/link";
---

<div class="grid grid-cols-2">
  <div class="space-y-12 px-6 py-45">
    <div class="space-y-8">
      <h1 class="font-display text-7xl">Explore the Unknown</h1>
      <p class="text-xl text-balance">
        Ben Miller has 8 years of experience in keynote and workshop
        facilitation in leadership, personal and organisational resilience.
      </p>
    </div>
    <Link
      to="/services"
      class="inline-flex items-center gap-2 rounded-md border border-geraldine-500 bg-geraldine-400 px-6 py-4 text-xl font-medium transition-colors hover:bg-geraldine-300"
    >
      View services
      <ArrowRightIcon className="size-5" weight="bold" />
    </Link>
  </div>
</div>
