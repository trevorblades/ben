---
import { Image } from "astro:assets";
import Link from "astro-typesafe-routes/link";
import hero from "~/assets/images/hero.png";
---

<div class="relative z-0 grid-cols-10 sm:grid">
  <div
    class="relative z-10 col-span-6 space-y-6 py-24 layout-gutter sm:space-y-8 sm:py-30 md:space-y-10 md:py-40 lg:col-span-5 lg:space-y-12"
  >
    <div class="space-y-2 sm:space-y-4 md:space-y-6 lg:space-y-8">
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
        Explore the Unknown
      </h1>
      <p class="text-base text-balance md:text-lg lg:text-xl">
        Ben Miller has 8 years of experience in keynote and workshop
        facilitation in leadership, personal and organisational resilience.
      </p>
    </div>
    <Link to="/services" class="btn-md btn-primary btn md:btn-lg">
      View services →</Link
    >
  </div>
  <div
    class="col-span-4 max-sm:absolute max-sm:inset-0 max-sm:mask-l-to-70% lg:col-span-5"
  >
    <Image
      src={hero}
      alt="person exploring a cave with a torch"
      class="size-full object-cover object-left"
    />
  </div>
</div>
