---
import Link from "astro-typesafe-routes/link";
import Logo from "~/assets/logo.svg";
---

<footer class="bg-melanzane text-lace">
  <div
    class="flex gap-4 py-6 layout-container layout-gutter sm:justify-between md:py-8"
  >
    <div class="flex items-center gap-6">
      <Logo class="size-6 fill-current" />
      <nav class="max-sm:hidden">
        <ul class="flex gap-4">
          <li>
            <Link class="link link-hover" to="/">About</Link>
          </li>
          <li>
            <Link class="link link-hover" to="/services">Services</Link>
          </li>
          <li>
            <Link class="link link-hover" to="/contact">Contact</Link>
          </li>
          <li>
            <a
              target="_blank"
              rel="noreferrer"
              class="link link-hover"
              href="https://substack.com"
              >Substack ↗</a
            >
          </li>
        </ul>
      </nav>
    </div>
    <div>&copy; 2026 Ben Miller Leadership</div>
  </div>
</footer>
