---
import Link from "astro-typesafe-routes/link";
---

<div class="border-b border-lace/20 bg-melanzane text-lace">
  <div class="py-16 layout-container layout-gutter sm:py-24 md:py-30">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-8 md:gap-12">
      <h2 class="text-center font-display text-3xl sm:text-4xl md:text-5xl">
        Connect, learn, and grow
      </h2>
      <Link class="btn-lg btn-primary btn" to="/contact">
        Request a consultation →
      </Link>
    </div>
  </div>
</div>
