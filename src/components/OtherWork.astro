---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  image: ImageMetadata;
  title: string;
  url: string;
};

const { image, title, url } = Astro.props;
---

<div class="flex flex-col items-start gap-4 rounded-xl bg-white p-4">
  <Image
    alt={title}
    src={image}
    class="aspect-video w-full rounded-md object-cover"
  />
  <h3 class="font-display text-2xl">{title}</h3>
  <p class="text-balance">
    <slot />
  </p>
  <a
    class="mt-auto btn-md btn-secondary btn"
    href={url}
    target="_blank"
    rel="noopener"
  >
    Learn more →
  </a>
</div>
