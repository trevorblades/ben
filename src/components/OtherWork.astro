---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  image: ImageMetadata;
  title: string;
  url: string;
};

const { image, title, url } = Astro.props;
---

<div
  class="flex flex-col items-start gap-3 rounded-xl bg-white p-3 md:gap-4 md:p-4"
>
  <Image
    alt={title}
    src={image}
    class="aspect-video w-full rounded-md object-cover"
  />
  <div class="space-y-1 md:space-y-2">
    <h3 class="font-display text-xl md:text-2xl">{title}</h3>
    <p class="text-balance">
      <slot />
    </p>
  </div>
  <a
    class="mt-auto btn-sm btn-secondary btn"
    href={url}
    target="_blank"
    rel="noopener"
  >
    Learn more →
  </a>
</div>
