---
import Link from "astro-typesafe-routes/link";
import Logo from "~/assets/logo.svg";
---

<header class="sticky top-0 z-10 bg-lace">
  <div
    class="mx-auto flex max-w-360 items-center justify-between px-4 py-4 md:px-6"
  >
    <Link to="/" class="flex items-center gap-3">
      <Logo class="size-9 fill-tangerine-400" />
      <div class="font-display text-lg leading-none font-medium">
        Ben Miller <br>Leadership
      </div>
    </Link>
    <nav>
      <ul class="flex gap-6 font-medium">
        <li>
          <Link class="link link-hover" to="/">About</Link>
        </li>
        <li>
          <Link class="link link-hover" to="/services">Services</Link>
        </li>
        <li>
          <Link class="link link-hover" to="/contact">Contact</Link>
        </li>
      </ul>
    </nav>
  </div>
</header>
