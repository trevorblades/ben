---
import { ContactForm } from "~/components/ContactForm";
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Contact">
  <div
    class="space-y-12 pt-16 pb-12 layout-gutter sm:space-y-16 sm:pt-24 sm:pb-16 md:space-y-20 md:pt-30 md:pb-20"
  >
    <div
      class="mx-auto max-w-3xl space-y-4 text-center sm:space-y-6 md:space-y-8"
    >
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
        Request a Consultation
      </h1>
      <p class="text-base text-balance sm:text-lg md:text-xl">
        Complete the form below to reach out to Ben and receive a free
        consultation within 5 business days.
      </p>
    </div>
    <div class="mx-auto max-w-5xl space-y-6 md:space-y-8">
      <div class="rounded-xl bg-white">
        <ContactForm client:load />
      </div>
      <p class="mx-auto max-w-3xl text-center text-balance">
        If you'd prefer to strike up a conversation instead,{" "}
        <a class="link link-not-hover" href="mailto:ben@benmillerleadership.com"
          >reach out to Ben directly via email</a
        >.
      </p>
    </div>
  </div>
</Layout>
