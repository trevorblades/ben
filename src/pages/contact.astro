---
import { ContactForm } from "~/components/ContactForm";
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Contact">
  <div class="space-y-20 pt-30 pb-20 gutter">
    <div class="mx-auto max-w-3xl space-y-8 text-center">
      <h1 class="font-display text-7xl">Request a Consultation</h1>
      <p class="text-xl text-balance">
        Complete the form below to reach out to Ben and receive a free
        consultation within 5 business days.
      </p>
    </div>
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="rounded-xl bg-white">
        <ContactForm client:load />
      </div>
      <p class="mx-auto max-w-3xl text-center text-balance">
        If you'd prefer to strike up a conversation instead,{" "}
        <a class="link link-not-hover" href="mailto:ben@benmillerleadership.com"
          >reach out to Ben directly via email</a
        >.
      </p>
    </div>
  </div>
</Layout>
