---
import Link from "astro-typesafe-routes/link";
import BCHydro from "~/assets/logos/bc-hydro.svg";
import IBM from "~/assets/logos/ibm.svg";
import Lululemon from "~/assets/logos/lululemon.svg";
import Lush from "~/assets/logos/lush.svg";
import TransLink from "~/assets/logos/translink.svg";
import YVR from "~/assets/logos/yvr.svg";
import { QuoteAuthor } from "~/components/QuoteAuthor";
import Service from "~/components/Service.astro";
import { TestimonialCarousel } from "~/components/TestimonialCarousel";
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Services">
  <div
    class="space-y-8 pt-12 pb-12 layout-gutter sm:space-y-12 sm:pt-16 sm:pb-16 md:space-y-16 md:pt-24 md:pb-20 lg:space-y-20 lg:pt-30"
  >
    <div
      class="mx-auto max-w-3xl space-y-2 text-center sm:space-y-4 md:space-y-6 lg:space-y-8"
    >
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
        Services
      </h1>
      <p class="text-base text-balance md:text-lg lg:text-xl">
        Ben Miller has 8 years of experience in keynote and workshop
        facilitation in leadership, personal and organisational resilience.
      </p>
    </div>
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 md:gap-8">
      <div class="grid gap-4 sm:grid-cols-2 md:gap-6">
        <Service title="Brain-Based Coaching">
          Discover how understanding the brain can support clearer thinking,
          stronger habits, and more effective leadership. Build practical
          strategies for focus, resilience, and decision-making.
        </Service>
        <Service title="Leadership Development">
          Bring leaders together to strengthen communication, collaboration, and
          decision-making. Develop practical skills to navigate shared
          challenges and lead with confidence.
        </Service>
        <Service title="Mental Health & Leadership">
          Discover how understanding the brain can support clearer thinking,
          stronger habits, and more effective leadership. Build practical
          strategies for focus, resilience, and decision-making.
        </Service>
        <Service title="Quad Tandem Workshop & Talk">
          Bring leaders together to strengthen communication, collaboration, and
          decision-making. Develop practical skills to navigate shared
          challenges and lead with confidence.
        </Service>
      </div>
      <Link to="/contact" class="btn-md btn-primary btn md:btn-lg">
        Request a consultation →
      </Link>
    </div>
  </div>
  <div class="space-y-4 py-8 layout-gutter md:space-y-6 md:py-10">
    <h2 class="text-center font-display text-sm uppercase md:text-base">
      Trusted by the finest organizations
    </h2>
    <div
      class="flex flex-wrap justify-evenly gap-4 *:h-8 *:w-30 *:fill-current md:gap-6 md:*:h-10 md:*:w-37.5 lg:*:h-12 lg:*:w-45"
    >
      <Lululemon />
      <YVR />
      <IBM />
      <BCHydro />
      <TransLink />
    </div>
  </div>
  <TestimonialCarousel
    client:load
    testimonials={[
      {
        quote:
          "We had a lunch-and-learn with WIRTH Hats for our entire department. Ben presented the inspiring story of how WIRTH Hats came to be and allowed time at the end for team members to ask questions. Everyone got a WIRTH Hat and the feedback was very positive.",
        by: "Johanna Molloy",
        title: "Brand Operations Manager, Lush Cosmetics",
        logo: Lush.src,
      },
      {
        quote: "I love playing with Leon Draisaitl.",
        by: "Connor McDavid",
        title: "Center, Edmonton Oilers",
        logo: YVR.src,
      },
      {
        quote: "I love playing with Leon Draisaitl.",
        by: "Connor McDavid",
        title: "Center, Edmonton Oilers",
        logo: YVR.src,
      },
    ]}
  />
  <div
    class="mx-auto max-w-5xl space-y-4 py-12 text-center layout-gutter sm:py-16 md:space-y-6 md:py-24 lg:py-30"
  >
    <p class="text-xl leading-normal sm:text-2xl md:text-3xl lg:text-4xl">
      “Ben presented the inspiring story of how WIRTH Hats came to be and
      allowed time at the end for team members to ask questions.”
    </p>
    <QuoteAuthor
      name="Johanna Molloy"
      title="Brand Operations Manager, Lush Cosmetics"
    />
  </div>
</Layout>
